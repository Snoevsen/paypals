<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.sdu.paypals.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.sdu.paypals.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/groupsFragment"
        android:name="com.sdu.paypals.GroupsFragment"
        android:label="@string/title_groups"
        tools:layout="@layout/fragment_groups">
        <action
            android:id="@+id/action_groupsFragment_to_groupChatFragment"
            app:destination="@id/groupChatFragment" />
        <action
            android:id="@+id/action_groupsFragment_to_createGroupFragment"
            app:destination="@id/createGroupFragment" />
    </fragment>

    <fragment
        android:id="@+id/createGroupFragment"
        android:name="com.sdu.paypals.CreateGroupFragment"
        android:label="Create Group"
        tools:layout="@layout/fragment_create_group" />

    <fragment
        android:id="@+id/groupChatFragment"
        android:name="com.sdu.paypals.GroupChatFragment"
        android:label="Group"
        tools:layout="@layout/fragment_group_chat">
        <argument
            android:name="groupId"
            app:argType="string" />
        <action
            android:id="@+id/action_groupChatFragment_to_groupSettingsFragment"
            app:destination="@id/groupSettingsFragment" />
        <action
            android:id="@+id/action_groupChatFragment_to_groupBalanceFragment"
            app:destination="@id/groupBalanceFragment" />
    </fragment>

    <fragment
        android:id="@+id/groupBalanceFragment"
        android:name="com.sdu.paypals.GroupBalanceFragment"
        android:label="Group Balance"
        tools:layout="@layout/fragment_group_balance">
        <argument
            android:name="groupId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/groupSettingsFragment"
        android:name="com.sdu.paypals.GroupSettingsFragment"
        android:label="Group Settings"
        tools:layout="@layout/fragment_group_settings">
        <argument
            android:name="groupId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/activityFragment"
        android:name="com.sdu.paypals.ActivityFragment"
        android:label="@string/title_activity"
        tools:layout="@layout/fragment_activity" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.sdu.paypals.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" />

    <action
        android:id="@+id/action_global_to_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

</navigation>
